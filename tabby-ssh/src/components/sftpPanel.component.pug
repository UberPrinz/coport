.header
    input.form-control.form-control-sm.flex-grow-1.w-0(
        #pathInput,
        *ngIf='editingPath !== null',
        type='text',
        data-testid='path-input',
        (keydown)='onPathInputKeyDown($event)',
        (blur)='cancelPathEdit($event)',
        (click)='$event.stopPropagation()',
        [(ngModel)]='editingPath'
    )
    .breadcrumb(*ngIf='editingPath === null', (dblclick)='editPath($event)')
        a.breadcrumb-item.text-decoration-none((click)='navigate("/")') {{rootLabel}}
        a.breadcrumb-item.text-decoration-none(
            *ngFor='let segment of pathSegments',
            (click)='navigate(segment.path)'
        ) {{segment.name}}

    .breadcrumb-spacer.flex-grow-1.h-100(
        *ngIf='editingPath === null',
        data-testid='path-edit-spacer',
        title='Click to edit path',
        (click)='editPath($event)',
        (dblclick)='editPath($event)'
    )

    button.btn.btn-link.btn-sm.flex-shrink-0.px-1(
        *ngIf='editingPath === null',
        type='button',
        data-testid='edit-path-btn',
        title='Edit path',
        (click)='editPath($event)'
    )
        i.fas.fa-pen

    button.btn.btn-link.btn-sm.flex-shrink-0.px-1(
        type='button',
        data-testid='favorite-toggle',
        [title]='isCurrentPathFavorite ? "Remove from favorites" : "Add to favorites"',
        (click)='toggleCurrentFavorite($event)'
    )
        i.fas.fa-star.text-warning(*ngIf='isCurrentPathFavorite')
        i.far.fa-star(*ngIf='!isCurrentPathFavorite')

    .places-dropdown.position-relative.flex-shrink-0
        button.btn.btn-link.btn-sm.d-flex.align-items-center(
            type='button',
            data-testid='places-toggle',
            title='Favorites and recent directories',
            (click)='togglePlacesDropdown($event)'
        )
            i.fas.fa-bookmark.me-1
            i.fas.fa-caret-down
        .places-menu.shadow(
            *ngIf='showPlacesDropdown',
            data-testid='places-menu',
            (click)='$event.stopPropagation()'
        )
            .places-section.places-section-favorites(data-testid='places-favorites')
                .places-section-title Favorites
                .places-empty(*ngIf='favorites.length === 0') No favorites yet
                .places-item(
                    *ngFor='let fav of favorites',
                    [class.active]='fav === path',
                    [attr.data-path]='fav',
                    data-testid='places-favorite-item',
                    (click)='openPlace(fav, $event)'
                )
                    i.fas.fa-star.text-warning.me-2.flex-shrink-0
                    span.places-path([title]='fav') {{fav}}
                    button.btn.btn-link.btn-sm.places-remove.p-0.ms-2(
                        type='button',
                        data-testid='places-remove-favorite',
                        title='Remove favorite',
                        (click)='removeFavoritePath(fav, $event)'
                    )
                        i.fas.fa-times
            .places-divider
            .places-section.places-section-recent(data-testid='places-recent')
                .places-section-title Recent
                .places-empty(*ngIf='recentPaths.length === 0') No recent directories
                .places-item(
                    *ngFor='let recent of recentPaths',
                    [class.active]='recent === path',
                    [attr.data-path]='recent',
                    data-testid='places-recent-item',
                    (click)='openPlace(recent, $event)'
                )
                    i.fas.fa-history.me-2.flex-shrink-0
                    span.places-path([title]='recent') {{recent}}

    button.btn.btn-link.btn-sm.flex-shrink-0.d-flex(type='button', (click)='refresh()')
        i.fas.fa-sync-alt.me-1
        div(translate) Refresh

    button.btn.btn-link.btn-sm.flex-shrink-0.d-flex(type='button', *ngIf='!showFilter', (click)='openFilter($event)')
        i.fas.fa-filter.me-1
        div(translate) Filter

    button.btn.btn-link.btn-sm.flex-shrink-0.d-flex(type='button', (click)='openCreateDirectoryModal()')
        i.fas.fa-plus.me-1
        div(translate) Create directory

    button.btn.btn-link.btn-sm.flex-shrink-0.d-flex(type='button', (click)='upload()')
        i.fas.fa-upload.me-1
        div(translate) Upload files

    button.btn.btn-link.btn-sm.flex-shrink-0.d-flex(type='button', (click)='uploadFolder()')
        i.fas.fa-upload.me-1
        div(translate) Upload folder

    button.btn.btn-link.text-decoration-none(type='button', (click)='close()') !{require('../../../tabby-core/src/icons/times.svg')}

.favorites-bar(*ngIf='favorites.length > 0', data-testid='favorites-bar')
    .favorite-chip(
        *ngFor='let fav of favorites',
        [class.active]='fav === path',
        [attr.data-path]='fav',
        [title]='fav',
        data-testid='favorite-chip',
        (click)='navigate(fav)'
    )
        i.fas.fa-star.text-warning.me-1
        span.favorite-chip-label {{getPathLabel(fav)}}
        button.favorite-chip-remove(
            type='button',
            data-testid='favorite-chip-remove',
            title='Remove favorite',
            (click)='removeFavoritePath(fav, $event)'
        )
            i.fas.fa-times

.filter-bar.px-3.py-2.border-bottom(*ngIf='showFilter', data-testid='filter-bar')
    .input-group.input-group-sm
        input.form-control(
            #filterInput,
            type='text',
            placeholder='Filter...',
            data-testid='filter-input',
            [ngModel]='filterText',
            (ngModelChange)='onFilterTextChange($event)'
        )
        span.input-group-text.filter-count(*ngIf='fileList !== null', data-testid='filter-count') {{filteredEntries.length}} / {{fileList.length}}
        button.btn.btn-secondary(type='button', data-testid='filter-clear', (click)='clearFilter(true)')
            i.fas.fa-times

.status-banner.alert.alert-warning.d-flex.align-items-center.mb-0(
    *ngIf='fallbackNotice',
    data-testid='fallback-banner'
)
    i.fas.fa-exclamation-triangle.me-2.flex-shrink-0
    .me-auto.status-banner-text
        span Could not open {{fallbackNotice.requestedPath}} ({{fallbackNotice.reason}}). Opened {{fallbackNotice.resolvedPath}} instead.
    button.btn.btn-link.btn-sm.p-0.ms-2.flex-shrink-0(
        type='button',
        data-testid='dismiss-fallback-banner',
        (click)='fallbackNotice = null'
    )
        i.fas.fa-times

.status-banner.alert.alert-danger.d-flex.align-items-center.mb-0(
    *ngIf='errorNotice && !loadError',
    data-testid='error-banner'
)
    i.fas.fa-exclamation-circle.me-2.flex-shrink-0
    .me-auto.status-banner-text
        span Could not open {{errorNotice.path}}: {{errorNotice.message}}
    button.btn.btn-link.btn-sm.p-0.ms-2.flex-shrink-0(
        type='button',
        data-testid='dismiss-error-banner',
        (click)='errorNotice = null'
    )
        i.fas.fa-times

.body(#bodyContainer, (scroll)='onBodyScroll()', dropZone, [dropTarget]='getDropTarget', (transferAt)='uploadOneFolder($event.upload, $event.target)')
    a.alert.alert-info.d-flex.align-items-center(
        *ngIf='shouldShowCWDTip && cwdDetectionAvailable === false',
        (click)='platform.openExternal("https://tabby.sh/go/cwd-detection")'
    )
        .me-auto
            strong(translate) Working directory detection
            div(translate) Learn how to allow Tabby to detect remote shell's working directory.
        button.close(type='button', (click)='dismissCWDTip()')
            i.fas.fa-close

    div(*ngIf='!sftp && !loadError', translate) Connecting

    .load-error.alert.alert-danger.d-flex.align-items-center(*ngIf='loadError', data-testid='load-error')
        i.fas.fa-exclamation-triangle.me-2.flex-shrink-0
        .me-auto
            .fw-bold Could not open {{loadError.path}}
            .small {{loadError.message}}
        button.btn.btn-sm.btn-outline-light.ms-3.flex-shrink-0(
            type='button',
            data-testid='retry-button',
            (click)='retryLoad()'
        )
            i.fas.fa-redo.me-1
            span Retry

    div(*ngIf='sftp && !loadError')
        div(*ngIf='fileList === null', translate) Loading
        .list-group.list-group-light(*ngIf='fileList !== null')
            .list-group-item.list-group-item-action.d-flex.align-items-center(
                *ngIf='path !== "/" && (!isFilterActive || filteredEntries.length === 0)',
                data-testid='go-up-item',
                (click)='goUp()'
            )
                i.fas.fa-fw.fa-level-up-alt
                div(translate) Go up
            .virtual-spacer(*ngIf='topSpacerHeight > 0', [style.height.px]='topSpacerHeight')
            .list-group-item.list-group-item-action.d-flex.align-items-center.file-row(
                *ngFor='let row of visibleEntries; trackBy: trackByVisibleRow',
                [class.selected]='row.index === selectedIndex',
                [attr.data-index]='row.index',
                [attr.data-name]='row.entry.item.name',
                (contextmenu)='onItemContextMenu(row.entry.item, row.index, $event)',
                (click)='onItemClick(row.entry.item, row.index)'
            )
                i.fa-fw([class]='row.icon')
                .file-name
                    ng-container(*ngFor='let seg of row.entry.segments; trackBy: trackBySegment')
                        mark.filter-match(*ngIf='seg.highlighted') {{seg.text}}
                        span(*ngIf='!seg.highlighted') {{seg.text}}
                .me-auto
                .size(*ngIf='!row.entry.item.isDirectory') {{row.entry.item.size|filesize}}
                .date {{row.entry.item.modified|tabbyDate}}
                .mode {{row.mode}}
            .virtual-spacer(*ngIf='bottomSpacerHeight > 0', [style.height.px]='bottomSpacerHeight')
        .alert.alert-info.text-center.mt-3(
            *ngIf='fileList !== null && filteredEntries.length === 0 && isFilterActive',
            data-testid='no-match-alert'
        )
            i.fas.fa-search.me-2
            span(translate) No files match the filter "{{filterText}}"
