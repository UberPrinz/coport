{
  "tools": [
    {
      "description": "Read shared terminal committed lines and current line. History remains readable while disconnected. wait_ms waits for new lines only with after_line.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "after_line": {
            "minimum": -1,
            "type": "integer"
          },
          "max_lines": {
            "default": 200,
            "maximum": 2000,
            "minimum": 1,
            "type": "integer"
          },
          "wait_ms": {
            "default": 0,
            "maximum": 10000,
            "minimum": 0,
            "type": "integer"
          }
        },
        "type": "object"
      },
      "name": "read_terminal"
    },
    {
      "description": "Queue raw bytes on the current serial port. Tabby shared sessions reject conflicting input. encoding is utf8 (default) or hex. 1...65536 encoded bytes.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "data": {
            "type": "string"
          },
          "encoding": {
            "default": "utf8",
            "enum": [
              "utf8",
              "hex"
            ],
            "type": "string"
          }
        },
        "required": [
          "data"
        ],
        "type": "object"
      },
      "name": "write_serial"
    },
    {
      "description": "Execute a device sh command via ADB when available, otherwise the prepared idle serial shell. Serial timeout sends Ctrl+C; ADB timeout kills local adb only. Read terminal before prepare_shell if serial is not prepared.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "command": {
            "minLength": 1,
            "type": "string"
          },
          "max_output_bytes": {
            "default": 262144,
            "maximum": 4194304,
            "minimum": 1024,
            "type": "integer"
          },
          "timeout_ms": {
            "default": 30000,
            "maximum": 600000,
            "minimum": 1000,
            "type": "integer"
          }
        },
        "required": [
          "command"
        ],
        "type": "object"
      },
      "name": "exec"
    },
    {
      "description": "Get the currently viewed log snapshot: device_path, local_path, filter and search. log is null when no file is open. Local snapshot expires when Coport quits.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {},
        "type": "object"
      },
      "name": "get_view_state"
    },
    {
      "description": "Prepare serial shell markers. First read_terminal and confirm a shell prompt ending # or $. Rejects fullscreen, pending human input and continuation prompts. Never prepares automatically.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {},
        "type": "object"
      },
      "name": "prepare_shell"
    },
    {
      "description": "Open or join a Coport shared serial profile in Tabby and bind this MCP connection to its session.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "baud": {
            "default": 115200,
            "maximum": 4294967295,
            "minimum": 1,
            "type": "integer"
          },
          "dataBits": {
            "default": 8,
            "maximum": 8,
            "minimum": 5,
            "type": "integer"
          },
          "flowControl": {
            "default": "none",
            "enum": [
              "none",
              "hardware",
              "software"
            ],
            "type": "string"
          },
          "parity": {
            "default": "none",
            "enum": [
              "none",
              "odd",
              "even"
            ],
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "stopBits": {
            "default": 1,
            "enum": [
              1,
              2
            ],
            "type": "integer"
          }
        },
        "required": [
          "path"
        ],
        "type": "object"
      },
      "name": "open_serial"
    }
  ],
